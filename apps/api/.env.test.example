NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://fillip:localdev123@localhost:5432/reporte_aqui_test
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Combined per-IP request budget across register+login within the 15-minute
# rate-limit window (shared bucket, not per-route).
AUTH_RATE_LIMIT_MAX=20
R2_BUCKET=reporte-aqui-media-test
R2_ENDPOINT=https://test-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=test-access-key-id
R2_SECRET_ACCESS_KEY=test-secret-access-key
R2_PUBLIC_URL_BASE=https://media-test.example.com
