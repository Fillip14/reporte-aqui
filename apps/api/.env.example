NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://fillip:localdev123@localhost:5432/reporte_aqui_dev
JWT_SECRET=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Combined per-IP request budget across register+login within the 15-minute
# rate-limit window (shared bucket, not per-route).
AUTH_RATE_LIMIT_MAX=20
R2_BUCKET=reporte-aqui-media-dev
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_PUBLIC_URL_BASE=https://media.example.com
